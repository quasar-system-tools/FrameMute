{
  "name": "framemute",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "assets:mediapipe": "node scripts/copy-mediapipe-assets.mjs",
    "dev:desktop": "npm run dev --workspace @framemute/desktop --",
    "build:desktop": "npm run build --workspace @framemute/desktop",
    "tauri:desktop": "npm run tauri --workspace @framemute/desktop --",
    "dev:web": "npm run dev --workspace @framemute/web --",
    "build:web": "npm run build --workspace @framemute/web",
    "test": "vitest run",
    "test:vision": "playwright test",
    "test:vision:local": "playwright test tests/vision-runtime.spec.ts --grep local-image",
    "test:vision:editor-local": "playwright test tests/vision-runtime.spec.ts --grep local-editor",
    "verify": "npm run assets:mediapipe && npm run test && npm run test:vision && npm run build:desktop && npm run build:web && npm run verify:native --workspace @framemute/desktop"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vitest": "^4.1.10"
  }
}
